PORT=3000
# REQUIRED: key used to encrypt stored OAuth tokens at rest. The server will not start without it
# (demo mode, with no OAuth credentials configured, is the only exception). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Fallback environment-level credentials if client_secrets.json is not present
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
