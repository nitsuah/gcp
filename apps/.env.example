PORT=3000
# Interface to bind. Defaults to 127.0.0.1 (loopback only).
# HOST=127.0.0.1
# Access token for the dashboard and API (min 16 chars). Required when HOST is not loopback.
# If unset on loopback, a one-time token is generated and printed at startup.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_AUTH_TOKEN=
# Local-dev opt-out (loopback only): APP_AUTH_DISABLED=1
# Extra Host header names to accept, comma separated (loopback requests always allow localhost/127.0.0.1).
# ALLOWED_HOSTS=
# Behind a TLS-terminating reverse proxy, trust it so session cookies are marked Secure
# (Express "trust proxy" value: a hop count like 1, or loopback/an address list).
# TRUST_PROXY=
# REQUIRED: key used to encrypt stored OAuth tokens at rest. The server will not start without it
# (demo mode, with no OAuth credentials configured, is the only exception). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Fallback environment-level credentials if client_secrets.json is not present
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
